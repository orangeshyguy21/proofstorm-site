---
import Layout from '../layouts/Layout.astro';
import Brand from '../components/Brand.astro';
---
<Layout title="Page not found — Proofstorm" description="This page could not be found. Return to Proofstorm to get started.">
  <main id="main" class="page-shell py-12">
    <Brand />
    <p class="mt-20 font-mono text-sm text-storm">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Page not found.</h1>
    <a href="/" class="mt-8 inline-block border border-line px-5 py-3 text-sm hover:border-storm">Back to Proofstorm</a>
  </main>
</Layout>
