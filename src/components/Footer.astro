---
import wordmark from '../assets/brand/proofstorm-word-mark.svg?raw';
---
<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-brand" href="/" aria-label="Proofstorm home">
      <span aria-hidden="true" set:html={wordmark} />
    </a>
    <nav aria-label="Footer navigation">
      <ul class="footer-links">
        <li><a href="https://github.com/orangeshyguy21/proofstorm" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href="https://github.com/orangeshyguy21/proofstorm/releases" target="_blank" rel="noopener noreferrer">Releases</a></li>
        <li>
          <a class="back-to-top" href="#main">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5" /></svg>
            Back to top
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 2.75rem 1.5rem;
    background: #070a0f;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: min(100%, 84rem);
    margin-inline: auto;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 10rem;
    max-width: 100%;
    min-height: 2.75rem;
    opacity: .75;
    transition: opacity 150ms;
  }
  .footer-brand:hover, .footer-brand:focus-visible { opacity: 1; }
  .footer-brand > span { display: block; width: 100%; }
  .footer-brand :global(svg) { display: block; width: 100%; height: auto; }
  .footer-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: .25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.75rem;
    padding-block: .5rem;
    color: #9ca6b5;
    font: .8125rem/1.5 var(--font-mono);
    text-underline-offset: .3em;
    transition: color 150ms;
  }
  .footer-links a:hover { color: #e5e7eb; text-decoration: underline; text-decoration-color: #ff3b3b; }
  .back-to-top svg { width: .875rem; height: .875rem; flex-shrink: 0; color: #ff5b61; }
  @media (max-width: 640px) {
    .site-footer { padding: 2.25rem 1rem 2.75rem; }
    .footer-inner { flex-direction: column; gap: 1rem; }
    .footer-links { justify-content: center; column-gap: 1.5rem; }
  }
</style>
