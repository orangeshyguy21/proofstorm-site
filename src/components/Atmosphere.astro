---
import { Image } from 'astro:assets';
import stormArt from '../assets/proofstorm-storm.png';
---
<div class="atmosphere" aria-hidden="true">
  <div class="atmosphere-glow"></div>
  <Image src={stormArt} alt="" widths={[768, 1536]} sizes="100vw" format="webp" quality={90} class="atmosphere-landscape" loading="eager" fetchpriority="high" decoding="async" />
  <svg class="signal-field" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <pattern id="signal-grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M80 0H0V80" stroke="#9ca3af" stroke-opacity=".1" stroke-width=".6" /><circle cx="0" cy="0" r="1" fill="#9ca3af" fill-opacity=".35" /></pattern>
      <radialGradient id="signal-mask"><stop offset=".25" stop-color="white" stop-opacity=".1" /><stop offset=".63" stop-color="white" /><stop offset="1" stop-color="white" stop-opacity="0" /></radialGradient>
      <mask id="signal-fade"><rect width="1600" height="1000" fill="url(#signal-mask)" /></mask>
    </defs>
    <g mask="url(#signal-fade)">
      <rect width="1600" height="1000" fill="url(#signal-grid)" />
      <g stroke="#ff3b3b" stroke-opacity=".24" stroke-width=".7">
        <path d="M0 720H190L330 580H510M0 740H204L344 600H510" />
        <path d="M1600 270H1430L1280 420H1100M1600 290H1444L1294 440H1100" />
        <path d="M1600 810H1350L1190 650H1090" />
        <path d="M130 0V240L290 400H420" />
      </g>
      <g stroke="#ff3b3b" stroke-opacity=".55" stroke-width=".8">
        <path d="M286 389V403M279 396H293M1346 803V817M1339 810H1353" />
        <circle cx="1430" cy="270" r="3" />
        <circle cx="190" cy="720" r="3" />
      </g>
    </g>
  </svg>
  <div class="atmosphere-vignette"></div>
  <div class="atmosphere-scan"></div>
</div>
